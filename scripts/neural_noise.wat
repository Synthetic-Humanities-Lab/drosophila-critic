;; PCG XSL RR 128/64, identical to browser-random.js. Integer operations wrap
;; modulo 2^64; two words hold the original 128-bit state. No approximate math.
(module
  (global $lo (mut i64) (i64.const 0))
  (global $hi (mut i64) (i64.const 0))
  (global $incLo (mut i64) (i64.const 0))
  (global $incHi (mut i64) (i64.const 0))
  (func (export "reset") (param $lo i64) (param $hi i64) (param $incLo i64) (param $incHi i64)
    (global.set $lo (local.get $lo))
    (global.set $hi (local.get $hi))
    (global.set $incLo (local.get $incLo))
    (global.set $incHi (local.get $incHi)))
  (func (export "stateLo") (result i64) (global.get $lo))
  (func (export "stateHi") (result i64) (global.get $hi))
  (func $mulHi (param $a i64) (param $b i64) (result i64)
    (local $a0 i64) (local $a1 i64) (local $b0 i64) (local $b1 i64)
    (local $t i64) (local $w i64)
    (local.set $a0 (i64.and (local.get $a) (i64.const 0xffffffff)))
    (local.set $a1 (i64.shr_u (local.get $a) (i64.const 32)))
    (local.set $b0 (i64.and (local.get $b) (i64.const 0xffffffff)))
    (local.set $b1 (i64.shr_u (local.get $b) (i64.const 32)))
    (local.set $t (i64.add (i64.mul (local.get $a1) (local.get $b0))
      (i64.shr_u (i64.mul (local.get $a0) (local.get $b0)) (i64.const 32))))
    (local.set $w (i64.add (i64.and (local.get $t) (i64.const 0xffffffff))
      (i64.mul (local.get $a0) (local.get $b1))))
    (i64.add (i64.mul (local.get $a1) (local.get $b1))
      (i64.add (i64.shr_u (local.get $t) (i64.const 32))
        (i64.shr_u (local.get $w) (i64.const 32)))))
  (func $next (export "next") (result f64)
    (local $product i64) (local $lo i64) (local $hi i64)
    (local.set $product (i64.mul (global.get $lo) (i64.const 4865540595714422341)))
    (local.set $lo (i64.add (local.get $product) (global.get $incLo)))
    (local.set $hi (i64.add
      (i64.add (call $mulHi (global.get $lo) (i64.const 4865540595714422341))
        (i64.mul (global.get $hi) (i64.const 4865540595714422341)))
      (i64.add (i64.mul (global.get $lo) (i64.const 2549297995355413924))
        (i64.add (global.get $incHi)
          (i64.extend_i32_u (i64.lt_u (local.get $lo) (local.get $product)))))))
    (global.set $lo (local.get $lo))
    (global.set $hi (local.get $hi))
    (f64.mul (f64.convert_i64_u
      (i64.shr_u (i64.rotr (i64.xor (local.get $lo) (local.get $hi))
        (i64.shr_u (local.get $hi) (i64.const 58))) (i64.const 11)))
      (f64.const 0x1p-53)))
  ;; Return up to 32 decisions per call without allocating WASM linear memory.
  ;; Preserve every draw, including probability zero and the final partial word.
  (func (export "mask") (param $neurons i32) (param $probability f64) (result i32)
    (local $i i32) (local $mask i32)
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (local.get $neurons)))
      (if (f64.lt (call $next) (local.get $probability)) (then
        (local.set $mask (i32.or (local.get $mask) (i32.shl (i32.const 1) (local.get $i))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $loop)))
    (local.get $mask)))
